# Password per entrare nell'editor (/studio)
ABITA_PASSWORD=
# Chiave lunga e casuale per collegare Claude via MCP (Authorization: Bearer ...)
ABITA_TOKEN=
# Cloudflare D1 (su Vercel). Il database si trova per nome ("abita-database"); oppure scrivi l'id in CLOUDFLARE_D1_DATABASE_ID.
# Il token serve con il permesso Account > D1 > Edit. Senza queste due, in locale i dati stanno in .dati/abita.sqlite
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Il vecchio Upstash Redis: solo per copiare i progetti in D1 la prima volta, poi si può togliere
KV_REST_API_URL=
KV_REST_API_TOKEN=
